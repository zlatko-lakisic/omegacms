# Copy this file to ".env" in the solution root and fill in real values.
# Real ".env" files are gitignored — never commit secrets.
# ASP.NET Core maps nested config to env vars: double-underscore, e.g.:
#   Config:MD.CMS.BusinessLogic.Core:RootAdminAccount:Password
# becomes:
#   Config__MD.CMS.BusinessLogic.Core__RootAdminAccount__Password
#
# CloudFormation ad-hoc test deploy (VPC, ACM, SMTP, MySQL, S3 keys): not in this file.
# See MD.CMS.AwsLambda.CloudFormation.Core\TestRun.env.example and copy to TestRun.env there.

# --- Git (Jenkins, local tooling) — required for pipelines that clone or list tags ---
OMEGA_GIT_URL=https://github.com/zlatko-lakisic/omegacms.git

# Root Jenkinsfile (webhook) — remote build trigger (never commit the token)
# OMEGA_REMOTE_JENKINS_NAME=
# OMEGA_REMOTE_JENKINS_JOB_MASTER=
# OMEGA_REMOTE_JENKINS_JOB_PRODUCTION=
# OMEGA_REMOTE_JENKINS_TOKEN=
# OMEGA_SLACK_CHANNEL=
# OMEGA_SLACK_CREDENTIAL_ID=

# Jenkinsfile-AwsLambda.jdp — DNS / deploy host (optional; defaults to example.com in pipeline)
# OMEGA_DEPLOY_FQDN_SUFFIX=client.example.com
# OMEGA_DNS_ZONE=example.com

# --- Public / dev URLs (optional overrides) ---
OMEGA_ADMIN_HOST_URL=http://localhost:5050
OMEGA_WEBAPI_HOST_URL=http://localhost:5051
OMEGA_CMS_IIS_DEV_ADMIN=http://localhost:5000
OMEGA_CMS_IIS_DEV_WEBAPI=http://localhost:5001

# --- Google Cloud (integration test only) ---
# OMEGA_GCS_TEST_CREDENTIALS_JSON={"type":"service_account",...}
# OMEGA_GCS_TEST_BUCKET=
# OMEGA_GCS_TEST_PROJECT=

# --- ASP.NET: business logic (see appsettings / Config section) ---
# Hierarchical settings use "__" (see Microsoft docs: Colon in env = __).
# Example segment with dots stays one part: "MD.CMS.BusinessLogic.Core" below.
Config__MD.CMS.BusinessLogic.Core__RootAdminAccount__Username=root
Config__MD.CMS.BusinessLogic.Core__RootAdminAccount__Password=
# SMTP (outbound email; do not commit real host or credentials)
Config__MD.CMS.BusinessLogic.Core__EmailHost=
Config__MD.CMS.BusinessLogic.Core__EmailPort=587
Config__MD.CMS.BusinessLogic.Core__EmailEnableSsl=true
Config__MD.CMS.BusinessLogic.Core__Username=
Config__MD.CMS.BusinessLogic.Core__Password=
Config__MD.CMS.BusinessLogic.WebApi.Core__SecureApiAesSalt=
Config__MD.CMS.WebApi.Core__GoogleApiKey=

# --- Local SSL tools (Tools/ssl/*.ps1) — wildcard CN for cert requests ---
# OMEGA_SSL_CERT_DOMAIN=*.core.cms.example.com

# --- Jenkins (also listed under Jenkins/omega-pipeline.env.example) ---
# NUGET_SOURCE_URL=
# NUGET_KEY=
# OMEGA_CMS_INTERNAL_WS_BASE=
# OMEGA_CMS_REGISTRY_ADMIN_PASSWORD=
# STAGING_WINRM_PASSWORD=
# CLOUDNS_AUTH_ID=
# CLOUDNS_AUTH_PASSWORD=
