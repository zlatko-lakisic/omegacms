# AWS Lambda: values that were previously embedded in aws-lambda-tools-defaults.json
# and launchSettings. Do not commit real credentials.
# After copying to lambda.env (gitignored) or your secrets store, fill these and
# merge into the deploy tool / CloudFormation "template-parameters" as your process requires.
#
# Common keys (see serverless.templates in each Lambda project; fill only in private lambda.env):
# MDCMSBusinessLogicCoreEmailHost=
# MDCMSBusinessLogicCoreEmailPort=587
# MDCMSBusinessLogicCoreEmailEnableSsl=true
# MDCMSBusinessLogicCoreUsername=
# MDCMSBusinessLogicCorePassword=
# MDCMSBusinessLogicCoreRootAdminAccount JSON: {"Username":"root","Password":""}
# MDCMSBusinessLogicCoreGoogleApiTranslationKey=
# MDCMSBusinessLogicCoreGoogleMapsJsKey=
# MDToolsHelpersCoreProviderOptions JSON for S3 (AccessKey, SecretKey, etc.)
# MySQL / Solr / JDBC substrings in DataAccessPluginSettings (host, user, password)

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
GOOGLE_API_KEY=
SMTP_EMAIL_USER=
SMTP_EMAIL_PASSWORD=
# Maps to MDCMSBusinessLogicCore* template parameters at deploy time
OMEGA_SMTP_HOST=
OMEGA_SMTP_USER=
OMEGA_SMTP_PASSWORD=
CMS_DB_PASSWORD=
