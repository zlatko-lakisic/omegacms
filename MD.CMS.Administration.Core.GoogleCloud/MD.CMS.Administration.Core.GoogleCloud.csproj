<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
    <TypeScriptToolsVersion>Latest</TypeScriptToolsVersion>
    <Configurations>Debug;Release;Release_Publish_win_x64;Release_Publish_linux_x64;Release_Publish_osx_x64</Configurations>
    <Version>0.89.15</Version>
    <Authors>Omega IT LLC</Authors>
    <Product>OmegaCMS Google Cloud App Engine Administration</Product>
    <Copyright>2022</Copyright>
    <PackageProjectUrl>https://omega-it.solutions</PackageProjectUrl>
    <PackageIcon>0.png</PackageIcon>
    <AssemblyName>MD.CMS.Administration.Core.GoogleCloud</AssemblyName>
    <ApplicationIcon>omega-icon.ico</ApplicationIcon>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DocumentationFile>$(OutputPath)$(AssemblyName).xml</DocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="wwwroot\js\min\**" />
    <Compile Remove="wwwroot\scripts\.scannerwork\**" />
    <Content Remove="wwwroot\js\min\**" />
    <Content Remove="wwwroot\scripts\.scannerwork\**" />
    <EmbeddedResource Remove="wwwroot\js\min\**" />
    <EmbeddedResource Remove="wwwroot\scripts\.scannerwork\**" />
    <None Remove="wwwroot\js\min\**" />
    <None Remove="wwwroot\scripts\.scannerwork\**" />
  </ItemGroup>
  <ItemGroup>
    <EntityDeploy Remove="%2a%2a/%2a.edmx" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\MD.CMS.Administration\MD.CMS.Administration.Core\MD.CMS.Administration.Core.csproj" />
    <ProjectReference Include="..\MD.CMS.BusinessLogic.GoogleCloud.Core\MD.CMS.BusinessLogic.GoogleCloud.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="wwwroot\" />
  </ItemGroup>
  <ItemGroup>
    <None Include="wwwroot\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <ItemGroup>
    <None Remove="wwwroot\scripts\.scannerwork" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\0.png">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
    </None>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="AspNetCore.HealthChecks.UI.Client" Version="3.1.2" />
  </ItemGroup>
  <ItemGroup>
    <Content Update="Views\Error402\Index.cshtml">
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Update="Views\Error404\Index.cshtml">
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Update="Views\Error500\Index.cshtml">
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Update="Views\Home\Index.cshtml">
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <None Update="dispatch.yaml">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="app.yaml">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <Target Name="PostBuild" AfterTargets="PostBuildEvent" Condition="'$(OmegaRunAdminAssetPipeline)' == 'true'">
    <Exec Command="call &quot;$(ProjectDir)..\MD.CMS.Administration\gulp-inject.bat&quot;&#xD;&#xA;call &quot;$(ProjectDir)..\MD.CMS.Administration\gulp-generateBusinessLogicCompiled.bat&quot;&#xD;&#xA;call &quot;$(ProjectDir)build-scripts.$(ConfigurationName).bat&quot;&#xD;&#xA;&quot;%25ProgramFiles(x86)%25\Microsoft Visual Studio\2019\Enterprise\MSBuild\Current\Bin\msbuild&quot; &quot;$(ProjectDir)..\MD.CMS.Administration.Core.Hosted\YuiCompressorMsBuild.$(ConfigurationName).proj" />
  </Target>
</Project>
