<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ApplicationIcon>omega-icon.ico</ApplicationIcon>
    <Version>0.89.15</Version>
    <PackageId>MD.CMS.WebApi.Core.GoogleCloud</PackageId>
    <Authors>Omega IT LLC</Authors>
    <Company>Omega IT LLC</Company>
    <Product>OmegaCMS Google Cloud App Engine Web API</Product>
    <Copyright>2022</Copyright>
    <PackageProjectUrl>https://omega-it.solutions</PackageProjectUrl>
    <PackageIcon>0.png</PackageIcon>
    <PackageIconUrl />
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DocumentationFile>$(OutputPath)$(AssemblyName).xml</DocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AspNetCore.HealthChecks.UI" Version="3.1.3" />
    <PackageReference Include="AspNetCore.HealthChecks.UI.Client" Version="3.1.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MD.CMS.BusinessLogic.GoogleCloud.Core\MD.CMS.BusinessLogic.GoogleCloud.Core.csproj" />
    <ProjectReference Include="..\MD.CMS.BusinessLogic.WebApi.Core\MD.CMS.BusinessLogic.WebApi.Core.csproj" />
    <ProjectReference Include="..\MD.CMS.WebApi.Core\MD.CMS.WebApi.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="appSettings.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <None Update="app.yaml">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Include="..\0.png">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
    </None>
  </ItemGroup>


</Project>
