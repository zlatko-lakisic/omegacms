[Unit]
Description=Kestrel service running .NET Core MD.CMS.WebApi.Core.dll

[Service]
WorkingDirectory=/var/www/html/ws/
ExecStart=/usr/bin/dotnet /var/www/html/ws/MD.CMS.WebApi.Core.dll
Restart=always
RestartSec=10 # restart after 10 sec if crashed
SyslogIdentifier=dotnet-kestrel
User=md-admin
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=DOTNET_PRINT_TELEMETRY_MESSAGE=false

[Install]
WantedBy=multi-user.target