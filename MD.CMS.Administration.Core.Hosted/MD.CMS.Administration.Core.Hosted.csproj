<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <TypeScriptToolsVersion>Latest</TypeScriptToolsVersion>
    <IsTransformWebConfigDisabled>true</IsTransformWebConfigDisabled>
    <IsWebConfigTransformDisabled>true</IsWebConfigTransformDisabled>
    <Version>0.89.15</Version>
    <Company>Omega IT LLC</Company>
    <Product>OmegaCMS Hosted Administration</Product>
    <PackageProjectUrl>https://omega-it.solutions</PackageProjectUrl>
    <Copyright>2022</Copyright>
    <Authors>Omega IT LLC</Authors>
    <UserSecretsId>c86e8433-1aae-4540-b84e-d5121dc2a0cb</UserSecretsId>
    <ApplicationIcon>omega-icon.ico</ApplicationIcon>
    <RunAnalyzersDuringBuild>true</RunAnalyzersDuringBuild>
    <RunAnalyzersDuringLiveAnalysis>true</RunAnalyzersDuringLiveAnalysis>
    <AssemblyName>MD.CMS.Administration.Core.Hosted</AssemblyName>
    <PackageIcon>0.png</PackageIcon>
    <PackageIconUrl />
    <NeutralLanguage>en-GB</NeutralLanguage>
    <Configurations>Debug;Release;Debug_Publish_win_x64;Debug_Publish_linux_x64;Debug_Publish_osx_x64;Release_Publish_win_x64;Release_Publish_linux_x64;Release_Publish_osx_x64</Configurations>
  </PropertyGroup>
  <PropertyGroup>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="wwwroot\js\gridstack\**" />
    <Content Remove="wwwroot\js\gridstack\**" />
    <EmbeddedResource Remove="wwwroot\js\**" />
    <None Remove="wwwroot\js\**" />
    <None Include="..\0.png">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
    </None>
  </ItemGroup>
  <ItemGroup>
    <Content Remove="web - Copy.debug-win-x64.config" />
  </ItemGroup>
  <ItemGroup>
    <None Include="YuiCompressorMsBuild.Debug.proj" />
    <None Include="YuiCompressorMsBuild.Release.proj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="DotNetEnv" Version="3.2.0" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.NewtonsoftJson" Version="10.0.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.Common" Version="4.12.0" />
    <PackageReference Include="Obfuscar" Version="2.2.29">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="YUICompressor.NET.MSBuild" Version="3.0.0" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="logs\" />
    <Folder Include="wwwroot\" />
    <Folder Include="wwwroot\css\min\" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\MD.CMS.Administration\MD.CMS.Administration.Core\MD.CMS.Administration.Core.csproj" />
    <ProjectReference Include="..\MD.Tools.Licensing\MD.Tools.Licensing.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Update="Obfuscar.Release.xml">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <TypeScriptTarget>ES5</TypeScriptTarget>
    <TypeScriptJSXEmit>None</TypeScriptJSXEmit>
    <TypeScriptModuleKind>AMD</TypeScriptModuleKind>
    <TypeScriptCompileOnSaveEnabled>False</TypeScriptCompileOnSaveEnabled>
    <TypeScriptNoImplicitAny>False</TypeScriptNoImplicitAny>
    <TypeScriptRemoveComments>True</TypeScriptRemoveComments>
    <TypeScriptOutFile>$(OutputPath)$(AssemblyName).xml</TypeScriptOutFile>
    <TypeScriptOutDir />
    <TypeScriptGeneratesDeclarations>False</TypeScriptGeneratesDeclarations>
    <TypeScriptNoEmitOnError>True</TypeScriptNoEmitOnError>
    <TypeScriptSourceMap>True</TypeScriptSourceMap>
    <TypeScriptMapRoot />
    <TypeScriptSourceRoot>../../businessLogic</TypeScriptSourceRoot>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Debug_Publish_osx_x64'">
