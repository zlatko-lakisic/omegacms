      </BaseBusinessLoginc_JavascriptFiles>
      <BaseBusinessLoginc_JavascriptFiles Include="node_modules\moment-timezone\builds\moment-timezone-with-data-1970-2030.min.js">
        <CompressionType>None</CompressionType>
      </BaseBusinessLoginc_JavascriptFiles>
      <BaseBusinessLoginc_JavascriptFiles Include="wwwroot\scripts\businessLogicMinified\businessLogic.compiled.js"/>

    
  
  
  </ItemGroup>

    <CssCompressorTask
          SourceFiles="@(CssFiles)"
          OutputFile="wwwroot\css\min\all.min.css"
          LoggingType="Debug"
       />

    <JavaScriptCompressorTask
          SourceFiles="@(BaseBusinessLoginc_JavascriptFiles)"
          OutputFile="wwwroot\scripts\businessLogicMinified\md.cms.businessLogic.min.js"
          LoggingType="Debug"
       />

    <JavaScriptCompressorTask
          SourceFiles="@(JavaScriptFiles)"
          OutputFile="wwwroot\js\min\all.min.js"
          LoggingType="Debug"
       />

  </Target>
</Project>
