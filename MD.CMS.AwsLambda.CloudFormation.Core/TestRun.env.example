# CloudFormation one-off test deploy (TestRun-Create / TestRun-Update / TestRun-Delete)
# 1) Copy this file to "TestRun.env" in the same directory as the TestRun-*.ps1 scripts.
# 2) Fill in your AWS account values. Never commit TestRun.env.
# 3) Run TestRun-Create.ps1 or TestRun-Update.ps1 from that directory (env is auto-loaded).
#
# Lines: KEY=value. No spaces around =. For connection strings, put the full string after the first =.

# --- Stack & DNS ---
OMEGA_CF_STACK_NAME=
# Public hostname for the stack (CORS, session, deploy)
OMEGA_CF_DOMAIN=
# e.g. 1.0.6
OMEGA_CF_CONTAINER_VERSION=
# CMS build version, e.g. 0.82.76
OMEGA_CF_CMS_VERSION=
# Lambda plugins layer number (string)
OMEGA_CF_PLUGINS_LAYER_VERSION=
# Full ARN of extra layer(s)
OMEGA_CF_OTHER_PLUGINS_ARN=
# Full ACM cert ARN for HTTPS
OMEGA_CF_ACM_CERTIFICATE_ARN=
# e.g. us-east-1
OMEGA_AWS_REGION=

# --- VPC (private subnets for Lambda) ---
OMEGA_CF_VPC_SECURITY_GROUP_ID=
OMEGA_CF_VPC_SUBNET1_ID=
OMEGA_CF_VPC_SUBNET2_ID=

# --- Outbound email (used as template parameters) ---
OMEGA_SMTP_USER=
OMEGA_SMTP_PASSWORD=
OMEGA_SMTP_HOST=
OMEGA_SMTP_PORT=587
OMEGA_SMTP_USE_SSL=true

# --- MySQL connection for MD.Tools.BaseDataAccess.Plugins.MySql.Core (one line) ---
# Example shape: DataSource=host;Database=db;User=user;Password=;CharSet=utf8;convert zero datetime=True;Default Command Timeout=60
OMEGA_CMS_MYSQL_CONNECTION_STRING=

# --- S3 / uploads (IAM key pair passed into WebApi S3 file provider) ---
OMEGA_CMS_UPLOADS_ACCESS_KEY_ID=
OMEGA_CMS_UPLOADS_SECRET_ACCESS_KEY=
