{
  "metadata": [
    {
      "src": [
        {
          "files": [
            "**.csproj"
          ],
          "src": "../../MD.Tools.Helpers.Core"
        }
      ],
      "dest": "api/md.tools.helpers.core",
      "shouldSkipMarkup": true
    },
    {
      "src": [
        {
          "files": [
            "**.csproj"
          ],
          "src": "../../MD.CMS.BusinessLogic.Core"
        }
      ],
      "dest": "api/md.cms.businesslogic.core",
      "shouldSkipMarkup": true
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "api/**.yml",
          "api/index.md"
        ]
      },
      {
        "files": [
          "articles/**.md",
          "articles/**/toc.yml",
          "toc.yml",
          "*.md"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "images/**"
        ]
      }
    ],
    "overwrite": [
      {
        "files": [
          "apidoc/**.md"
        ],
        "exclude": [
          "_site/**"
        ]
      }
    ],
    "dest": "E:\\documentation\\assembly",
    "globalMetadataFiles": [],
    "fileMetadataFiles": [],
    "template": [
      "default",
      "templates/material"
    ],
    "postProcessors": [],
    "markdownEngineName": "markdig",
    "noLangKeyword": false,
    "keepFileLink": false,
    "cleanupCacheHistory": false,
    "disableGitFeatures": false
  }
}