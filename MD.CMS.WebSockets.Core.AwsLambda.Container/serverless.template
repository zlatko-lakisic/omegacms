        "SendMessageFunction",
        "OmegaCmsWebApiWebSockets"
      ],
      "Properties": {
        "Action": "lambda:InvokeFunction",
        "FunctionName": {
          "Ref": "SendMessageFunction"
        },
        "Principal": "apigateway.amazonaws.com"
      }
    }
  },
  "Outputs": {
    "WebSocketURI": {
      "Value": {
        "Fn::Sub": [
            "wss://${OmegaCmsWebApiWebSockets}.execute-api.${AWS::Region}.amazonaws.com/${BaseApiPath}/",
            { 
                "BaseApiPath": { "Ref" : "StageName" } 
            }
        ]
      },
      "Description": "The WSS Protocol URI to connect to"
    }
  }
}