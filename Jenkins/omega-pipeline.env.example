# Template for values used by Groovy Jenkins pipelines. Either:
#  - Set these in Jenkins (Manage Jenkins → System → Global properties → Environment variables), or
#  - For local Jenkins agents, create "Jenkins/credentials.env" from this file (see root .gitignore) and
#    source it before running a job, or use the Credentials/EnvInject plugin to load a .properties file.
# Variable names are read via System.getenv() in the pipelines (and via genericTools.getEnvString in stages).

# Git: tags query and clone (set this in Jenkins global env or job env; no default in pipeline code)
OMEGA_GIT_URL=https://github.com/zlatko-lakisic/omegacms.git

# Multibranch / webhook Jenkinsfile: Parameterized Remote Trigger + Slack (Jenkinsfile in repo root)
# OMEGA_REMOTE_JENKINS_NAME=
# OMEGA_REMOTE_JENKINS_JOB_MASTER=
# OMEGA_REMOTE_JENKINS_JOB_PRODUCTION=
# OMEGA_REMOTE_JENKINS_TOKEN=
# OMEGA_SLACK_CHANNEL=
# OMEGA_SLACK_CREDENTIAL_ID=

# AWS Lambda scripted pipeline (Jenkinsfile-AwsLambda.jdp): public hostname suffix for CloudFront / DNS
# OMEGA_DEPLOY_FQDN_SUFFIX=client.example.com
# OMEGA_DNS_ZONE=example.com

# NuGet push (Jenkins\Tools\DotNetTools.groovy, Jenkinsfile-Release.jdp)
NUGET_SOURCE_URL=
NUGET_KEY=

# Private NuGet (legacy example — point to your own feed)
# NUGET_SOURCE_URL=https://api.nuget.org/v3/index.json

# "Commit to registry" and CMS API smoke tests
OMEGA_CMS_INTERNAL_WS_BASE=
OMEGA_CMS_REGISTRY_ADMIN_PASSWORD=

# Staging: Jenkins-Local-Site-Setup.ps1 WinRM
STAGING_WINRM_PASSWORD=

# ClouDNS API (add-record)
CLOUDNS_AUTH_ID=
CLOUDNS_AUTH_PASSWORD=

# Demo email: avoid hardcoding demo passwords in the email body (pipelines use parameters where applicable)
# OMEGA_SMTP_HOST=
# OMEGA_SMTP_USER=
# OMEGA_SMTP_PASSWORD=
