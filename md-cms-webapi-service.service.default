[Unit]
Description=OmegaCMS WebApi ASP.NET Core on Linux

[Service]
# Path to site, default /var/www/site_name
WorkingDirectory=#Path_To_Site#/webapi
ExecStart=/usr/bin/dotnet #Path_To_Site#/webapi/MD.CMS.WebApi.Core.Hosted.dll
Restart=always
# Restart service after 10 seconds if the dotnet service crashes
RestartSec=10
KillSignal=SIGINT
SyslogIdentifier=md-cms-webapi
# User to run the app, default www-data
User=#User#
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=DOTNET_PRINT_TELEMETRY_MESSAGE=false
Environment=ASPNETCORE_URLS=http://localhost:5001

[Install]
WantedBy=multi-user.target